extends ../layout

block content
  .card.card-form
    h1 Recuperar password
    p.muted Ingresá tu email y te enviaremos un enlace para restablecer tu password.
    if info && info.message
      .alert.alert-error= info.message
    form(method='post', action='/forgotPassword')
      .form-group
        label(for='email') Email
        input#email(type='email', name='email', placeholder='tu@email.com', required, autofocus)
      button.btn.btn-primary.btn-block(type='submit') Enviar enlace
    .form-links
      a(href='/login') Volver al login
