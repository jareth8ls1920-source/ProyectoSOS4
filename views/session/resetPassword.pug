extends ../layout

block content
  .card.card-form
    h1 Restablecer password
    p.muted Ingresá tu nuevo password para la cuenta #{usuario.email}.
    form(method='post', action='/resetPassword')
      input(type='hidden', name='email', value=usuario.email)
      if errors.email
        .alert.alert-error= errors.email.message
      .form-group
        label(for='password') Nuevo password
        input#password(type='password', name='password', required, autofocus)
        if errors.password
          span.error= errors.password.message
      .form-group
        label(for='confirm_password') Confirmar password
        input#confirm_password(type='password', name='confirm_password', required)
        if errors.confirm_password
          span.error= errors.confirm_password.message
      button.btn.btn-primary.btn-block(type='submit') Guardar password
