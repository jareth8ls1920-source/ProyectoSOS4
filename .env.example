# Copiar este archivo a .env y completar los valores.
# En Heroku estas variables se cargan con `heroku config:set VAR=valor` (ver README).

# ---------------------------------------------------------------------------
# Entorno
#   development -> mongo local + emails por Ethereal
#   production  -> Mongo Atlas + emails por SendGrid (así corre en Heroku)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Base de datos
#   Local:  mongodb://localhost:27017/red_bicicletas_m4
#   Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/red_bicicletas?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/red_bicicletas_m4
MONGO_URI_TEST=mongodb://localhost:27017/red_bicicletas_m4_test

# ---------------------------------------------------------------------------
# Sesiones y JWT
# ---------------------------------------------------------------------------
SESSION_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
SECRET_KEY=cambiar_por_otro_secreto_para_jwt

# Host público (links de los emails y callback de Google)
#   Local:  http://localhost:3000
#   Heroku: https://<nombre-app>.herokuapp.com
HOST=http://localhost:3000

# ---------------------------------------------------------------------------
# Email
#   Desarrollo: Ethereal (https://ethereal.email). Si se dejan vacías, la app
#               crea una cuenta de prueba automáticamente y la imprime en consola.
#   Producción: SendGrid (https://app.sendgrid.com -> Settings -> API Keys).
#               MAIL_FROM debe ser un remitente verificado en SendGrid.
# ---------------------------------------------------------------------------
ETHEREAL_USER=
ETHEREAL_PWD=
SENDGRID_API_KEY=
MAIL_FROM=no-reply@redbicicletas.com

# ---------------------------------------------------------------------------
# Login con Google (OAuth 2.0) - https://console.cloud.google.com/apis/credentials
#   URI de redirección autorizada: <HOST>/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Login con Facebook (validación de token) - https://developers.facebook.com/apps
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------------------------------------------------------------------------
# New Relic (APM) - https://one.newrelic.com -> API keys -> License key
#   Sin license key el agente queda deshabilitado.
# ---------------------------------------------------------------------------
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Red Bicicletas
